# Copy to .env and fill in. .env is gitignored.
BAND_API_KEY=
ZOOWORK_API_KEY=
ZOOWORK_BASE_URL=https://clawapi.ecap.gsmo.ai/service/v1
TAVILY_API_KEY=
# Jev (TypeSafe) authority gate — without it the gate uses local policy rules, labelled as such
