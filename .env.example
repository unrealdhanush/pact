# Copy to .env and fill in. .env is gitignored.
# BAND human (account) key; registers ShopperAgent + MerchantAgent on first deal (keys cached in .env.band)
BAND_HUMAN_API_KEY=
ZOOWORK_API_KEY=
ZOOWORK_BASE_URL=https://clawapi.ecap.gsmo.ai/service/v1
TAVILY_API_KEY=
# Jev (TypeSafe) authority gate; without it the gate uses labelled local policy rules
JEV_API_KEY=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Optional
NOVITA_API_KEY=
# zoowork (default; falls back to local if no agent is set up) | local
PACT_MERCHANT=zoowork
